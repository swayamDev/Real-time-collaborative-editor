# Copy this file to .env.local and fill in the values.
#
# Local development (docker compose up -d): both URLs point at the same database.
DATABASE_URL=postgres://brahma:brahma@localhost:5432/brahma
DATABASE_URL_UNPOOLED=postgres://brahma:brahma@localhost:5432/brahma

# Neon
#
# DATABASE_URL is the POOLED connection string (host contains "-pooler").
# The app uses it at runtime, including the save path, which runs a short
# transaction with SELECT ... FOR UPDATE. PgBouncer in transaction mode keeps
# the whole transaction on one server connection, so the row lock holds.
# DATABASE_URL=postgres://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/brahma?sslmode=require
#
# DATABASE_URL_UNPOOLED is the DIRECT connection string (no "-pooler").
# Only drizzle-kit uses it, for migrations.
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/brahma?sslmode=require

# Sync server (workers/sync, `pnpm dev:sync`).
# NEXT_PUBLIC_SYNC_URL is the WebSocket base URL the browser connects to.
NEXT_PUBLIC_SYNC_URL=ws://localhost:8787
# SYNC_INTERNAL_URL is where the Next server calls the internal rename and
# delete API. SYNC_INTERNAL_SECRET must match the Worker's (workers/sync/.dev.vars).
SYNC_INTERNAL_URL=http://localhost:8787
SYNC_INTERNAL_SECRET=change-me-local-only

# Accounts (Better Auth)
# BETTER_AUTH_SECRET: 32+ random bytes, for example `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-local-only-change-me-local-only
# The public URL of the app. Auth cookies and redirects are tied to it.
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in (optional locally). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email: resend in production; console (log links) or file (test outbox) on localhost only.
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=Brahma <signin@example.com>
# Client address for per-address sign-in limits. Leave empty unless a proxy in
# front of the app overwrites this header with the real address (Vercel:
# x-forwarded-for, Cloudflare: cf-connecting-ip). Clients can send any header,
# so trusting one without such a proxy lets them dodge the limit.
AUTH_CLIENT_IP_HEADER=
# Optional: proxies (IPs or CIDR ranges) that append to X-Forwarded-For.
AUTH_TRUSTED_PROXIES=
# Optional: sign-in links sent per day across the whole site. The default, 80,
# stays under Resend's free plan (100 emails a day). Raise it on a paid plan.
MAGIC_LINK_DAILY_LIMIT=

# Sync tokens: Ed25519 private key (JWK with kid) that signs short-lived
# tokens for the sync server. Generate a pair with `pnpm keys:sync`; the
# matching public key goes to the Worker as SYNC_TOKEN_PUBLIC_KEYS.
SYNC_TOKEN_PRIVATE_KEY=
