    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "client-only": "^0.0.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
